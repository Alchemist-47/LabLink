# Copy to .env for local runs. Never commit real values.
SECRET_KEY=change-me-to-a-long-random-string
# memory (default, resets on restart) or firestore
LABLINK_STORAGE=memory
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_DATABASE=(default)
# Local runs against real Firestore only (Cloud Run uses its service account, no key file):
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
# Option A: Gemini API key from Google AI Studio
GEMINI_API_KEY=
# Option B: Vertex AI with the service account (set GEMINI_USE_VERTEX=1, no key needed)
# GEMINI_USE_VERTEX=1
# GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-flash-latest
AI_RATE_LIMIT=20
CAMPUS_TZ=Asia/Kolkata
